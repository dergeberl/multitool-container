{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^Dockerfile$"
      ],
      "matchStrings": [
        "ARG KUBECTL_TAG=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "registry.k8s.io/kubectl"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge kubectl version bumps (all version levels)",
      "matchManagers": [
        "regex"
      ],
      "matchDepNames": [
        "registry.k8s.io/kubectl"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": [
        "automerge"
      ]
    }
  ]
}
