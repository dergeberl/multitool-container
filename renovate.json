{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^Dockerfile$"
      ],
      "matchStrings": [
        "ARG KUBECTL_TAG=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "registry.k8s.io/kubectl"
    }
  ],
  "packageRules": [
    {
      "description": "Do not pin a sha256 digest for the ubuntu base image so it stays updatable",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "ubuntu",
        "docker.io/library/ubuntu",
        "library/ubuntu"
      ],
      "pinDigests": false,
      "pin": {
        "enabled": false
      }
    },
    {
      "description": "Auto-merge kubectl version bumps (all version levels)",
      "matchManagers": [
        "regex"
      ],
      "matchDepNames": [
        "registry.k8s.io/kubectl"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": [
        "automerge"
      ]
    }
  ],
  "pinDigests": true,
  "pin": {
    "enabled": true
  }
}
